# Copy to .env.production on the deployment host, not into Git.
# Use a long, URL-safe generated password because it is included in DATABASE_URL.
POSTGRES_PASSWORD=
API_PROXY_SECRET=
BACKEND_HOST=origin.example.com
# Comma-separated exact frontend origins. Used for HTTP and WebSocket checks.
ALLOWED_ORIGINS=https://cards.example.com
# Base production template: directory containing fullchain.pem and privkey.pem.
# VPS guide: /etc/letsencrypt, paired with its generated nginx.vps.conf.template
# that reads live/${BACKEND_HOST}/. Mount the full tree to preserve symlinks.
# Keep DNS API credentials outside this directory and outside all containers.
TLS_CERT_DIR=
# Managed voice relay. Set both from Cloudflare Realtime TURN.
# These stay on the backend; never put the API token in Pages or public variables.
CLOUDFLARE_TURN_TOKEN_ID=
CLOUDFLARE_TURN_API_TOKEN=
