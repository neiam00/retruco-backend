# Development values only. Set a unique password before deployment.
POSTGRES_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgres://retruco:replace-with-a-local-password@127.0.0.1:54329/retruco?sslmode=disable
LISTEN_ADDR=127.0.0.1:8080
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set true for every HTTPS deployment. False is only for local HTTP development.
COOKIE_SECURE=false

# Cloudflare Turnstile: required for account creation. Login and guest play remain available.
# Both keys stay in backend .env. Only the site key is exposed by /api/registration.
# Allow the frontend hostname(s) in the Turnstile widget and ALLOWED_ORIGINS.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Voice: local browsers can connect directly with these empty.
# For production set a DNS-only host that resolves to the TURN server (no HTTP proxy).
VOICE_STUN_URLS=
VOICE_TURN_URLS=
VOICE_TURN_SECRET=
# Required only by compose.voice.yaml. Use the same host as the URLs above.
VOICE_TURN_REALM=
VOICE_TURN_EXTERNAL_IP=
# Required behind the production edge; set the identical secret in Cloudflare Pages.
# Leave empty only when running the API directly for local development.
API_PROXY_SECRET=

# Used only by cmd/upload-assets. Never put these in frontend environment files.
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=
